# =============================================================================
# SiteCorp · Plantilla de Variables de Entorno (Agnóstica de Proveedor)
# =============================================================================
# En desarrollo inicial no necesitas definir estas variables si ya están en
# `src/shared/config/app-config.ts`. En un servidor de producción o contenedor
# local, puedes inyectarlas desde variables de entorno o un Key Vault.

# 1. Gateway de Datos / PostgREST / API (agnóstico de proveedor)
VITE_API_BASE_URL=https://xvswjkpoeccgpiewptur.supabase.co
VITE_API_PUBLIC_KEY=sb_publishable_4ZKRypToE3sUnlo_oAGdRA_KhkLmieP

# 2. Esquema físico de base de datos (auto | legacy | company_client)
VITE_DB_SCHEMA_TARGET=auto

# 3. Sesiones propias en PostgreSQL (public.user_sessions)
VITE_AUTH_SESSION_STORAGE_KEY=sitecorp_custom_session_token
VITE_AUTH_SESSION_HEADER_NAME=x-sitecorp-session
VITE_STORAGE_AVATARS_BUCKET=avatars

# 4. Políticas de seguridad y contraseñas (sincronizadas con PostgreSQL pgcrypto)
VITE_SECURITY_PASSWORD_MIN_LENGTH=12
VITE_SECURITY_INITIAL_PASSWORD_LENGTH=24
VITE_SECURITY_MAX_LOGIN_ATTEMPTS=5
VITE_SECURITY_LOCKOUT_MINUTES=15
VITE_SECURITY_SESSION_HOURS=8
