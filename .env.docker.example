# =============================================================================
# SITECORP — VARIABLES DE ENTORNO PARA DOCKER DESKTOP EN MACOS (APPLE SILICON)
# =============================================================================
# Copie este archivo a `.env` en la raíz del proyecto si desea personalizar
# puertos o credenciales locales antes de ejecutar `docker compose up -d --build`.
# Ningún secreto real de producción está ni debe estar incluido en Git.

# 1. PostgreSQL 16 Local
POSTGRES_USER=sitecorp
POSTGRES_PASSWORD=sitecorp_local_dev_only
POSTGRES_DB=sitecorp
POSTGRES_PORT=5432

# 2. Frontend React + Vite (Modo Autónomo self_hosted)
FRONTEND_PORT=3000
VITE_AUTH_PROVIDER=self_hosted
# El navegador se comunica con http://localhost:3000 y el proxy de Vite
# redirige /api y /health hacia el contenedor auth-api:4010 (mismo origen).
VITE_AUTH_API_URL=http://localhost:3000
VITE_BACKEND_PROXY_TARGET=http://auth-api:4010

# 3. Backend Autónomo Fastify (auth-api)
AUTH_API_PORT=4010
SITECORP_AUTH_ENV=development
SITECORP_HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SITECORP_HTTP_COOKIE_SECURE=false
SITECORP_HTTP_COOKIE_SAMESITE=Lax
SITECORP_AUTO_MIGRATE=true
# En modo development, si SITECORP_JWT_PRIVATE_KEY_PEM y SITECORP_CSRF_HMAC_SECRET
# están vacíos, el contenedor genera automáticamente un par Ed25519 y un secreto CSRF
# criptográficamente seguros en el primer arranque y los persiste en el volumen local.
SITECORP_AUTO_GENERATE_DEV_KEYS=true
SITECORP_ALLOW_INITIAL_ADMIN_BOOTSTRAP=true
SITECORP_JWT_ISSUER=urn:sitecorp:auth-api
SITECORP_JWT_AUDIENCE=urn:sitecorp:api
SITECORP_JWT_ACTIVE_KID=ed25519-local-dev-v1
SITECORP_JWT_PRIVATE_KEY_PEM=
SITECORP_JWT_PUBLIC_KEY_PEM=
SITECORP_CSRF_HMAC_SECRET=

# 4. Servidor SMTP de pruebas (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
