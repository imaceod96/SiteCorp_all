# =============================================================================
# SITECORP AUTH API — EJEMPLO DE VARIABLES DE ENTORNO (EXCLUSIVO DE auth-api)
# =============================================================================
# ADVERTENCIA: No almacene secretos reales en este archivo ni en el repositorio.
# En producción ("production"), todas las claves y secretos son obligatorios
# y el servicio aplica arranque fail-closed.

# 1. Entorno de ejecución ('development' | 'test' | 'production')
SITECORP_AUTH_ENV=development

# 2. Red y Proxy Inverso
SITECORP_HTTP_HOST=127.0.0.1
SITECORP_HTTP_PORT=4010
# Lista separada por comas de IPs/CIDRs de proxies inversos locales confiables.
# Vacío o 'false' desactiva trustProxy (por defecto seguro).
SITECORP_HTTP_TRUSTED_PROXIES=127.0.0.1,::1

# 3. Orígenes CORS / CSRF permitidos (obligatorio en producción, solo https://, sin '*')
SITECORP_HTTP_ALLOWED_ORIGINS=https://example.invalid

# 4. Límites HTTP y Timeouts
SITECORP_HTTP_GLOBAL_BODY_LIMIT_BYTES=16384
SITECORP_HTTP_AUTH_BODY_LIMIT_BYTES=4096
SITECORP_HTTP_REQUEST_TIMEOUT_MS=10000
SITECORP_HTTP_CONNECTION_TIMEOUT_MS=5000
SITECORP_HTTP_READINESS_TIMEOUT_MS=1500

# 5. Cookies y Protección CSRF (HMAC-SHA256 independiente de JWT)
SITECORP_HTTP_COOKIE_SECURE=true
SITECORP_HTTP_COOKIE_SAMESITE=Strict
SITECORP_HTTP_REFRESH_MAX_AGE_SECONDS=1209600
# Secreto HMAC-SHA256 de al menos 32 bytes (p. ej. 64 caracteres hex o 43+ base64url)
SITECORP_CSRF_HMAC_SECRET=REEMPLAZAR_CON_SECRETO_CSPRNG_DE_AL_MENOS_32_BYTES_EN_PRODUCCION
SITECORP_CSRF_TTL_SECONDS=1209600

# 6. Control de Concurrencia Argon2id (Dimensionar según fórmula de RAM del VPS)
SITECORP_ARGON2_MAX_CONCURRENT=2
SITECORP_ARGON2_MAX_QUEUE=8
SITECORP_ARGON2_QUEUE_TIMEOUT_MS=2500

# 7. Rate Limiting en Memoria (Acotado con LRU)
SITECORP_RATE_LIMIT_MAX_ENTRIES=10000
SITECORP_RATE_LIMIT_LOGIN_IP_MAX=10
SITECORP_RATE_LIMIT_LOGIN_IP_WINDOW_MS=60000
SITECORP_RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
SITECORP_RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_MS=60000

# 8. Logging Estructurado (Pino)
SITECORP_LOG_LEVEL=info
SITECORP_LOG_ENABLED=true

# 9. Parámetros Criptográficos (Argon2id y Ed25519 JWT)
SITECORP_ARGON2_MEMORY_KIB=19456
SITECORP_ARGON2_TIME_COST=2
SITECORP_ARGON2_PARALLELISM=1
SITECORP_JWT_ISSUER=urn:sitecorp:auth-api
SITECORP_JWT_AUDIENCE=urn:sitecorp:api
SITECORP_JWT_ACCESS_TTL_SECONDS=900
SITECORP_JWT_REQUIRE_SESSION_ID=true
SITECORP_JWT_ACTIVE_KID=ed25519-prod-2026-01
SITECORP_JWT_PRIVATE_KEY_PEM=
SITECORP_JWT_PUBLIC_KEY_PEM=
